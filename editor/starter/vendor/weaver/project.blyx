use weaver;
fn main() {
    let width = 320;
    let cols = we_columns(width, 8, 8, 80, 6);
    println!("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 120\" role=\"img\"><title>Five open files</title>");
    let mut i = 0;
    while i < 5 {
        let cell = we_rect(width, 8, 8, cols, 48, i);
        print!("<rect rx=\"5\" fill=\"#e2b841\" x=\""); print!(at(cell, 0));
        print!("\" y=\""); print!(at(cell, 1)); print!("\" width=\""); print!(at(cell, 2));
        print!("\" height=\""); print!(at(cell, 3)); println!("\"/>");
        print!("<text x=\""); print!(at(cell, 0) + 9.0); print!("\" y=\""); print!(at(cell, 1) + 29.0);
        print!("\">File "); print!(i + 1); println!("</text>");
        i += 1;
    }
    println!("</svg>");
}
